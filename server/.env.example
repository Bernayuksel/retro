# Zorunlu - token'ı ASLA koda / GitHub'a / sohbete yazmayın. Render > Environment bölümüne ekleyin.
GITHUB_TOKEN=

# GitHub Project sahibi ve numarası (şirket bilgilerini Git'e göndermeyin)
GITHUB_ORG=
GITHUB_PROJECT_NUMBER=
# Kullanıcıların dropdown'a erişmek için gireceği güçlü ve ayrı anahtar (GitHub token'ı değil)
GITHUB_PROJECT_ACCESS_KEY=
GITHUB_BOARD_FIELD=Board
GITHUB_SPRINT_FIELD=Sprint
GITHUB_STATUS_FIELD=Status
GITHUB_ESTIMATE_FIELD=Original Estimate
# Tamamlandı sayılacak durumlar (virgülle)
GITHUB_DONE_STATUSES=Done
